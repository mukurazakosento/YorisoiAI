{
  "name": "yorisoi-ai-functions",
  "private": true,
  "description": "Firebase Cloud Functions v2 for よりそいAI (Gemini via Secret Manager).",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
