# 秘密情報の置き場の例です。値は入れたままコミットしないでください。
# Gemini APIキー本体はアプリに置かず、Firebase Secret Manager で管理します（任意の旧経路のみ）。

# --- 端末内 AI（最終仕様の既定）---
# true のときだけ WebLLM / 将来のネイティブエンジンのロードを試みます。
# 失敗・未対応環境では必ず AI未接続＋デモ（live にはしません）。
# EXPO_PUBLIC_ON_DEVICE_AI=false
# WebLLM モデル ID（公開情報。秘密ではない）
# EXPO_PUBLIC_ON_DEVICE_MODEL_ID=Llama-3.2-1B-Instruct-q4f16_1-MLC

# --- アプリ（Expo）公開設定のみ ---
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-northeast1

# --- 旧 Gemini Cloud Functions（任意・非既定）---
# 最終仕様では必須ではありません。使うときだけ true。
# EXPO_PUBLIC_LEGACY_CLOUD_AI=false
# 後方互換: EXPO_PUBLIC_AI_CONNECTED も legacy として扱います
# EXPO_PUBLIC_AI_CONNECTED=false

# --- Cloud Functions（サーバー側・チャットに貼らない）---
# GEMINI_API_KEY は `firebase functions:secrets:set GEMINI_API_KEY` で設定
# GEMINI_MODEL_DEFAULT=gemini-3.5-flash-lite
# GEMINI_MODEL_GROUNDING=gemini-3.8-flash
# Web Risk（任意・URL検査のみ。未設定でもアプリは動くが照合は not_configured）
# WEBRISK_API_KEY は `firebase functions:secrets:set WEBRISK_API_KEY` で設定し、
# functions/src/ai/consult.ts の secrets 配列に webRiskApiKey を追加して再デプロイ
