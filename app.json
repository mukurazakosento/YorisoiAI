{
  "expo": {
    "name": "よりそいAI",
    "slug": "yorisoi-ai",
    "version": "0.13.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "yorisoi-ai",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yorisoi.ai",
      "infoPlist": {
        "CFBundleDisplayName": "よりそいAI",
        "NSPhotoLibraryUsageDescription": "スクリーンショットの文字を端末の中だけで読み取るために、写真ライブラリへのアクセスが必要です。"
      }
    },
    "android": {
      "package": "com.yorisoi.ai",
      "adaptiveIcon": {
        "backgroundColor": "#E6F3EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "スクリーンショットの文字を端末の中だけで読み取るために、写真ライブラリへのアクセスが必要です。"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "困っていることを声で伝えるために、マイクを使います。",
          "speechRecognitionPermission": "話した内容を文字にするために、音声認識を使います。"
        }
      ],
      "./modules/yorisoi-android-assist/app.plugin.js"
    ]
  }
}
