{
  "expo": {
    "name": "よりそいAI",
    "slug": "yorisoi-ai",
    "version": "0.11.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "yorisoi-ai",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yorisoi.ai",
      "infoPlist": {
        "CFBundleDisplayName": "よりそいAI",
        "NSPhotoLibraryUsageDescription": "スクリーンショットの文字を端末の中だけで読み取るために、写真ライブラリへのアクセスが必要です。"
      }
    },
    "android": {
      "package": "com.yorisoi.ai",
      "adaptiveIcon": {
        "backgroundColor": "#E6F3EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "スクリーンショットの文字を端末の中だけで読み取るために、写真ライブラリへのアクセスが必要です。"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}
