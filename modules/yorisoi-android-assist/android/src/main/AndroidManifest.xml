<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Permissions / service also injected by app.plugin.js for Expo prebuild. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <service
      android:name="expo.modules.yorisoiandroidassist.AssistForegroundService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection" />
    <!-- Optional: session-scoped dialog text when MediaProjection cannot see system permission UI. -->
    <service
      android:name="expo.modules.yorisoiandroidassist.AssistDialogAccessibilityService"
      android:exported="false"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/yorisoi_assist_accessibility" />
    </service>
  </application>
</manifest>
